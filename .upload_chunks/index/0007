  for(let y=0;y<3;y++)for(let x=0;x<3;x++)ctx.drawImage(map,xs[x],ys[y],xs[x+1]-xs[x],ys[y+1]-ys[y],dx[x],dy[y],dx[x+1]-dx[x],dy[y+1]-dy[y]);
  // Faint bounds marking keeps the larger arena legible without replacing ROM graphics.
  ctx.strokeStyle='#ffffff20';ctx.lineWidth=2;ctx.strokeRect(8,48,WORLD.w-16,WORLD.h-56);
 }
 function drawMinimap(){
  const w=FOV.w<420?84:103,h=FOV.w<420?58:69,x=FOV.w-w-8,y=FOV.h-h-8;
  ctx.fillStyle='#0a1928d8';ctx.fillRect(x-3,y-3,w+6,h+6);
  ctx.strokeStyle='#a6bed399';ctx.strokeRect(x-2,y-2,w+4,h+4);
  ctx.fillStyle='#315a4f';ctx.fillRect(x,y,w,h);
  // Current viewport rectangle and fighter positions in world coordinates.
  ctx.strokeStyle='#ffffff80';ctx.lineWidth=1;
  ctx.strokeRect(x+camera.x/WORLD.w*w,y+camera.y/WORLD.h*h,FOV.w/WORLD.w*w,FOV.h/WORLD.h*h);
  for(const f of fighters){
   ctx.fillStyle=f.hp<=0?'#5a616c':f.side===0?'#80f6c4':'#ff9d84';
   ctx.fillRect(Math.round(x+f.x/WORLD.w*w)-2,Math.round(y+f.y/WORLD.h*h)-2,4,4);
  }
 }
 function draw(){
 ctx.setTransform(canvas.width/FOV.w,0,0,canvas.height/FOV.h,0,0);ctx.imageSmoothingEnabled=false;
 ctx.clearRect(0,0,FOV.w,FOV.h);
 ctx.save();
 if(cameraShake>0)ctx.translate(rand(-1,1)*cameraShake*11,rand(-1,1)*cameraShake*7);
 ctx.translate(-camera.x,-camera.y);
 drawExtendedMap(romImgs[stageSelect.value]);
 for(const f of fighters.slice().sort((a,b)=>a.y-b.y))drawMon(f);
 for(const b of bullets)drawProjectile(b);
 for(const p of fx){ctx.globalAlpha=clamp(p.life/p.max,0,1);ctx.fillStyle=p.color;ctx.fillRect(p.x,p.y,p.size,p.size)}ctx.globalAlpha=1;
 drawSignatureFx();drawDamage();ctx.restore();
 drawHud();drawMinimap();drawSkillCinematic();
 if(finished){
  const mid=FOV.w/2,midY=FOV.h/2;
  ctx.fillStyle='#081421dc';ctx.fillRect(mid-148,midY-51,296,112);
  ctx.strokeStyle='#eec471';ctx.lineWidth=1.6;ctx.strokeRect(mid-148,midY-51,296,112);
  ctx.textAlign='center';ctx.fillStyle='#ffe399';ctx.font='bold 22px system-ui';
  ctx.fillText(winningSide===0?'아군 승리!':'상대 승리!',mid,midY-17);
  const winners=fighters.filter(f=>f.side===winningSide&&(f.hp>0||preview));const lay=(winners.length-1)*40;
  winners.forEach((f,i)=>{const im=getSprite(f.name,i%2?SP.cheer:SP.happy),x=mid-lay/2+i*40,y=midY+34;ctx.save();ctx.translate(x,y);
   if(im.complete&&im.naturalWidth){const fw=im.sheet?.w||im.naturalWidth,fh=im.sheet?.h||im.naturalHeight,sc=Math.min(1.6,36/fh);drawSpriteFrame(im,-fw*sc/2,-fh*sc,fw*sc,fh*sc,winElapsed)}ctx.restore()});
  ctx.font='9px system-ui';ctx.fillStyle='#b8c8dd';ctx.fillText('기쁨 #28 · 환호 #30 (승리 점프 미확정)',mid,midY+52);ctx.textAlign='left';
 }
}
 function loop(t){if(!running)return;const dt=Math.min(.048,Math.max(0,(t-last)/1000))*speed;last=t;
  if(!finished)update(dt);else winElapsed+=dt;
  draw();raf=requestAnimationFrame(loop);
 }
 window.addEventListener('keydown',e=>{if(e.key==='Escape'&&modal.style.display==='block')close()});reset();
})();
</script>
