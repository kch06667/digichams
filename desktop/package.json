{
  "name": "digimon-championship-desktop",
  "version": "0.1.0",
  "private": true,
  "description": "Standalone Windows shell for the existing Digimon Championship game",
  "main": "main.cjs",
  "scripts": {
    "start": "electron .",
    "build:win": "electron-builder --win portable --x64",
    "build:dir": "electron-builder --win dir --x64",
    "test": "node --test tests/*.test.cjs"
  },
  "devDependencies": {
    "electron": "^38.0.0",
    "electron-builder": "^26.0.0"
  },
  "build": {
    "appId": "local.digimon.championship",
    "productName": "Digimon Championship",
    "asar": true,
    "files": [
      "main.cjs",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "../index.html",
        "to": "game/index.html"
      },
      {
        "from": "../src",
        "to": "game/src",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "../assets",
        "to": "game/assets",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "../phaser-lab",
        "to": "game/phaser-lab",
        "filter": [
          "**/*",
          "!local-assets/**",
          "!node_modules/**",
          "!test-output/**"
        ]
      }
    ],
    "directories": {
      "output": "../dist/desktop"
    },
    "win": {
      "target": [
        "portable"
      ],
      "artifactName": "Digimon-Championship-${version}-Windows-${arch}.${ext}"
    }
  }
}
